#!/usr/bin/env bash
# CrabEFI build and test wrapper
#
# This script runs the xtask build system on the host (not the firmware target).
# Usage: ./crabefi [command] [options]

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Run xtask from within its own directory. The workspace
# rust-toolchain.toml pins the compiler for xtask and firmware alike.
cd "$SCRIPT_DIR/xtask"
exec cargo run -q -- --project-dir "$SCRIPT_DIR" "$@"
