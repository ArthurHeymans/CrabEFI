From 455cfdc8c7f13f8d4e57de337f7509b3f7e7e7d4 Mon Sep 17 00:00:00 2001
From: Arthur Heymans <arthur@aheymans.xyz>
Date: Wed, 18 Nov 2026 17:37:11 +0100
Subject: [PATCH 1/3] cpu/x86/smm: Clear the payload MM area on boot

SMRAM keeps its contents across a warm reset, but lb_payload_mm() cannot
clear the payload MM area: it runs after TSEG is enabled, when ramstage
no longer reaches SMRAM. The previous boot's payload MM stays registered,
so coreboot calls it on every SMI and rejects the payload's new load
request ("Payload MM already registered").

Clear the area while the SMI handler is installed, except on S3 resume
where the payload does not load its MM again.

TEST=CrabEFI runtime-image-test with CRABEFI_PAYLOAD_MM=1 on QEMU q35:
the second boot after a warm reset loads payload MM again.

Signed-off-by: Arthur Heymans <arthur@aheymans.xyz>
---
 src/cpu/x86/smm/smm_module_loader.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/cpu/x86/smm/smm_module_loader.c b/src/cpu/x86/smm/smm_module_loader.c
index cd5017ca6a..abb5284868 100644
--- a/src/cpu/x86/smm/smm_module_loader.c
+++ b/src/cpu/x86/smm/smm_module_loader.c
@@ -404,6 +404,19 @@ static void setup_smihandler_params(struct smm_runtime *mod_params,
 			memset((void *)state_base, 0, state_size);
 	}
 #endif
+
+	/*
+	 * SMRAM survives a warm reset. Drop the previous boot's payload MM, so
+	 * that it is not called and the payload can register again. Keep it on
+	 * S3 resume, where the payload does not reload it.
+	 */
+	if (CONFIG(PAYLOAD_MM_INTERFACE) && !acpi_is_wakeup_s3()) {
+		uintptr_t payload_base;
+		size_t payload_size;
+
+		if (!smm_subregion(SMM_SUBREGION_PAYLOAD, &payload_base, &payload_size))
+			memset((void *)payload_base, 0, payload_size);
+	}
 }
 
 static void print_region(const char *name, const struct region region)
