+config PAYLOAD_X86_64
+	bool "Call the payload in long (64-bit) mode"
+	depends on ARCH_RAMSTAGE_X86_64
+	help
+	  Leave long mode and identity-mapped paging enabled when calling the
+	  payload. Pass the physical coreboot table pointer in RDI using the
+	  x86-64 System V calling convention. The payload must support this
+	  entry ABI; there is no fallback to the legacy 32-bit payload ABI.
+
 config PAGE_TABLES_IN_CBFS
 	bool
 	default n
