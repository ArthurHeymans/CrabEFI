# Base fixture: native 64-bit coreboot caller, no payload.
# Apply coreboot-x86_64-payload.patch before building.
CONFIG_NO_POST=y
CONFIG_CBFS_SIZE=0x00700000
CONFIG_BOARD_EMULATION_QEMU_X86_Q35=y
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_3=y
CONFIG_USE_X86_64_SUPPORT=y
CONFIG_PAYLOAD_X86_64=y
CONFIG_PAYLOAD_NONE=y
